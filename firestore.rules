// Regras do Firestore Database para a Zeu-Tech
// Para publicar: copie e cole no Console do Firebase > Firestore Database > Rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permitir leitura e gravação completa para usuários autenticados
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
